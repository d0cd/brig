{
  "rate_limits": {
    "default": {
      "rate": 100,
      "burst": 500
    },
    "cells": {
      "heavy-user": {
        "rate": 10,
        "burst": 50
      }
    }
  },
  "log_filter": {
    "exclude_hosts": ["telemetry.*", "*.analytics.com"],
    "exclude_paths": ["/health", "/metrics", "/ping"],
    "min_status": 0,
    "sample_rate": 1.0
  },
  "log_quota": {
    "max_size_mb": 500
  },
  "policy_trace": {
    "enabled": false
  },
  "notifications": {
    "webhook_url": "",
    "filters": {
      "block_reasons": ["denied by rule", "not in allowlist"],
      "cells": null,
      "min_interval_seconds": 60
    }
  }
}
