{
  "allow": [
    "example.com",
    "*.example.com",
    "api.github.com",
    "*.githubusercontent.com",
    {
      "domain": "api.openai.com",
      "paths": ["/v1/*"],
      "methods": ["POST"]
    },
    {
      "domain": "registry.npmjs.org",
      "paths": ["/*"],
      "methods": ["GET"]
    }
  ],
  "deny": [
    "evil.com",
    "*.malware.com"
  ],
  "cells": {
    "trusted-cell": {
      "allow": ["internal.corp.com"],
      "deny": []
    }
  },
  "rate_limits": {
    "default": {
      "rate": 100,
      "burst": 500
    },
    "cells": {
      "heavy-user": {
        "rate": 10,
        "burst": 50
      }
    }
  },
  "log_filter": {
    "exclude_hosts": ["telemetry.*", "*.analytics.com"],
    "exclude_paths": ["/health", "/metrics", "/ping"],
    "min_status": 0,
    "sample_rate": 1.0
  },
  "log_retention": {
    "max_age_days": 7,
    "max_size_mb": 500,
    "compress_after_days": 1
  },
  "log_compaction": {
    "ai": {
      "enabled": false,
      "model": "claude-haiku-3",
      "preserve_verbatim": ["blocked", "error", "rate_limited", "cert_invalid"],
      "max_input_tokens": 50000,
      "cost_limit_daily_usd": 1.00
    }
  },
  "notifications": {
    "webhook_url": "",
    "filters": {
      "block_reasons": ["denied by rule", "not in allowlist"],
      "cells": null,
      "min_interval_seconds": 60
    }
  }
}
