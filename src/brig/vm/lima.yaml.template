# Brig Lima VM Configuration
# Generated by: brig init
# Reference: https://lima-vm.io/docs/reference/

images:
  - location: "https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-amd64.img"
    arch: "x86_64"
  - location: "https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-arm64.img"
    arch: "aarch64"

cpus: 4
memory: "8GiB"
disk: "50GiB"

mounts:
  - location: "~/.brig/cells"
    mountPoint: "/cells"
    writable: false
  - location: "~/.brig/secrets"
    mountPoint: "/secrets"
    writable: false
  - location: "~/.brig/state"
    mountPoint: "/state"
    writable: true

provision:
  - mode: system
    script: |
      #!/bin/bash
      set -eux

      # Install Podman
      apt-get update
      apt-get install -y podman uidmap slirp4netns fuse-overlayfs

      # Install gVisor (runsc) with integrity verification.
      ARCH=$(uname -m)
      curl -fsSL "https://storage.googleapis.com/gvisor/releases/release/latest/${ARCH}/runsc" -o /usr/local/bin/runsc
      curl -fsSL "https://storage.googleapis.com/gvisor/releases/release/latest/${ARCH}/runsc.sha512" -o /tmp/runsc.sha512
      cd /usr/local/bin && sha512sum -c /tmp/runsc.sha512
      chmod +x /usr/local/bin/runsc
      rm -f /tmp/runsc.sha512

      # Install crun (for Warden — proxy needs raw I/O, not gVisor overhead)
      apt-get install -y crun

      # Configure Podman to use gVisor by default
      mkdir -p /etc/containers
      cat > /etc/containers/containers.conf <<'CONF'
      [engine]
      runtime = "runsc"

      [engine.runtimes]
      runsc = ["/usr/local/bin/runsc"]
      crun = ["/usr/bin/crun"]
      CONF

      # Disable IPv6 (simplifies network policy enforcement)
      sysctl -w net.ipv6.conf.all.disable_ipv6=1
      sysctl -w net.ipv6.conf.default.disable_ipv6=1

      # Create proxy-external network
      podman network create proxy-external || true

      # Create log directory (coordination state lives on the host under
      # ~/.brig/state/system and reaches warden via the /state virtiofs mount).
      mkdir -p /var/log/brig/network
      chmod 755 /var/log/brig/network

      # Map the VM hostname to 127.0.0.1 so sudo doesn't pay a 5-second DNS
      # timeout resolving "lima-brig" for its logging — that delay was making
      # every "brig" command on the host feel hung.
      grep -q "$(hostname)" /etc/hosts || \
        echo "127.0.0.1 $(hostname)" >> /etc/hosts

      # Log rotation
      cat > /etc/logrotate.d/brig <<'LOGROTATE'
      /var/log/brig/network/*.jsonl {
        daily
        rotate 7
        compress
        missingok
        notifempty
      }
      LOGROTATE

      echo "Brig VM provisioning complete"
